# ==============================================================================
# MeowRobot Configuration Template File
# (Rename or copy this file to .env and fill in your values)
# ==============================================================================

# Enable environment variables mode
ENV=True

# Telegram Bot Token from @BotFather (Required)
TOKEN=

# Telegram API credentials from https://my.telegram.org/apps (Required)
API_ID=24168862
API_HASH=916a9424dd1e58ab7955001ccc0172b3

# Bot Owner Telegram User ID (Required)
OWNER_ID=8617644501

# Database URL: Leave empty to use local SQLite, or enter PostgreSQL URI
DATABASE_URL=

# MongoDB URI (Optional, for modules that support MongoDB)
MONGO_DB_URI=

# Channel ID for bot event logs (e.g. -1004454485434)
EVENT_LOGS=-1004454485434

# Telegraph / Catbox link of the image shown on /start
START_IMG=https://files.catbox.moe/4ntzos.jpg

# Telegram Support Group and Channel usernames (without @)
SUPPORT_CHAT=MeowClone
SUPPORT_CHANNEL=MeowCloner

# Allow '!' as command prefix along with '/' (True/False)
ALLOW_EXCL=True

# Delete command messages from users who lack permissions (True/False)
DEL_CMDS=True

# Currency Converter API Key from https://www.alphavantage.co/support/#api-key
CASH_API_KEY=W50UURP7Y0LEVKF4

# Timezone API URL from https://timezonedb.com/api
TIME_API_KEY=http://api.timezonedb.com/v2.1/convert-time-zone

# Chatbot AI API Configuration
CHATBOT_API_URL=https://chatbot.riteshyt.in/api/chat
CHATBOT_API_KEY=ritesh-8179b3a5da99f300be2d50e1e9789729
GEMINI_API_KEY=
